# Generated by the code-rule checker
.claude/reports/

# Session-accumulated permissions are never portable — start a fresh one
.claude/settings.local.json

# Python bytecode from .claude/scripts
__pycache__/
*.py[cod]

# Archives téléchargées par la maquette — rechargeables, jamais versionnées
maquette/.cache/

# Base construite par le socle — rechargeable en une commande, jamais versionnée
socle/parlement.db
socle/parlement.db-*

# Droit consolidé : la base se garde d'un jour sur l'autre (quinze minutes de
# lecture), mais elle se reconstruit avec recuperer_legi.py. Les archives
# téléchargées sont effacées au fil de l'eau ; le dossier reste ignoré au cas
# où une exécution s'interrompt.
socle/legi.db
socle/legi.db-*
socle/archives_legi/

# Le texte des versions successives d'un texte de loi : la base se garde
# d'un jour sur l'autre (2 295 documents lus un par un), mais elle se
# reconstruit avec recuperer_textes.py. Comme tout ce qui vient du
# Parlement, elle n'est jamais versionnée.
socle/textes.db
socle/textes.db-*
socle/*.log
socle/public/
